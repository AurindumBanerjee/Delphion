# Any OpenAI-compatible endpoint. Examples:
#   Groq          https://api.groq.com/openai/v1
#   OpenRouter    https://openrouter.ai/api/v1
#   Together      https://api.together.xyz/v1
#   Local Ollama  http://localhost:11434/v1   (LLM_API_KEY not needed)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# ^ paste your Groq key here (starts with gsk_). See README → "Getting a Groq key".

# Optional
EMBED_MODEL=BAAI/bge-small-en-v1.5
DEFAULT_K=4

# Retrieval: dense | bm25 | hybrid | hybrid_rerank
RETRIEVAL_MODE=hybrid_rerank
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20
